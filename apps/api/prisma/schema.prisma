// Referral & Rewards Platform — PostgreSQL schema.
//
// Conventions
// - UUID primary keys, snake_case table/column names via @@map/@map.
// - Money and points are stored as BIGINT integer minor units (`*_minor`). Never floats.
// - Critical invariants that Prisma cannot express (CHECK constraints, partial unique
//   indexes, guard/immutability triggers, double-entry balancing, exclusion constraints,
//   cross-row consistency) live in hand-written SQL in the migrations. See docs/database.md.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ChallengePurpose {
  EMAIL_VERIFICATION
  LOGIN_MFA
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum MfaMethod {
  EMAIL_OTP
  TOTP
}

enum MfaFactorKind {
  TOTP
}

/// Whether rewards are denominated in real currency or in non-cash points.
enum RewardUnit {
  MONEY
  POINTS
}

enum OfferingKind {
  PRODUCT
  SERVICE
}

enum OfferingStatus {
  ACTIVE
  INACTIVE
}

enum ProgramStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum BillingFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum RenewalPolicy {
  NONE
  MANUAL
  AUTOMATIC
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  REJECTED
}

enum EligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING_REVIEW
}

enum ReferralSource {
  REGISTRATION
  ADMIN_CORRECTION
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum RewardCalcType {
  FIXED
  PERCENTAGE
}

/// What happens to a level whose ancestor is missing, suspended or not eligible.
enum IneligibleAncestorBehavior {
  /// The level's reward is forfeited (not redistributed).
  FORFEIT
  /// Ineligible ancestors are skipped; the next eligible ancestor takes the level.
  COMPRESS
}

enum RoundingMode {
  HALF_UP
  HALF_EVEN
  DOWN
}

/// Business events that may trigger rewards: sales of an approved Offering to an end customer.
/// A member's own payment for a program Option (initial or renewal) is NEVER a qualifying event.
enum QualifyingEventType {
  PRODUCT_SALE
  SERVICE_COMPLETED
  SUBSCRIPTION_RENEWAL
}

enum QualifyingEventSource {
  ADMIN_MANUAL
  API
  WEBHOOK
}

enum QualifyingEventStatus {
  RECEIVED
  PROCESSED
  REJECTED
  REVERSED
}

enum CalculationOutcome {
  REWARDS_CREATED
  NO_ELIGIBLE_RECIPIENTS
}

enum RewardStatus {
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  REVERSED
}

enum LedgerAccountType {
  /// Platform-side account debited when a reward is posted (the reward cost).
  PLATFORM_REWARD_EXPENSE
  /// Per-member liability account credited when a reward is posted.
  MEMBER_REWARDS_PAYABLE
}

enum LedgerTransactionType {
  REWARD_POSTING
  REWARD_REVERSAL
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

enum FlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// ─────────────────────────────────────────────────────────────────────────────
// Reference data & platform settings
// ─────────────────────────────────────────────────────────────────────────────

/// ISO 4217 currencies the platform supports (seeded by migration). Ties a code to its minor units.
model Currency {
  code       String @id @db.Char(3)
  name       String @db.VarChar(64)
  minorUnits Int    @map("minor_units") @db.SmallInt

  platformSettings PlatformSettings[]
  programs         Program[]

  @@unique([code, minorUnits], map: "uq_currencies_code_minor_units")
  @@map("currencies")
}

/// Singleton row (id = 1).
model PlatformSettings {
  id                     Int        @id @default(1)
  /// MONEY or POINTS — default reward unit for new programs and the global display mode.
  rewardUnit             RewardUnit @default(POINTS) @map("reward_unit")
  /// ISO 4217 code used for prices and sale amounts, and for rewards in MONEY mode.
  currencyCode           String     @default("INR") @map("currency_code") @db.Char(3)
  /// Must equal currencies.minor_units for currencyCode (composite FK).
  currencyMinorUnits     Int        @default(2) @map("currency_minor_units") @db.SmallInt
  pointsLabel            String     @default("Points") @map("points_label") @db.VarChar(32)
  /// Default points per one major currency unit, copied into new policy versions.
  pointsPerCurrencyUnit  Int        @default(1) @map("points_per_currency_unit")
  /// Default total reward budget for new policy versions, in basis points of the sale amount.
  defaultRewardBudgetBps Int        @default(2000) @map("default_reward_budget_bps")
  /// Real-money payouts are not implemented. A CHECK constraint pins this to false; enabling it
  /// requires a reviewed migration after legal/KYC/payment-provider approval.
  payoutsEnabled         Boolean    @default(false) @map("payouts_enabled")
  version                Int        @default(1)
  updatedById            String?    @map("updated_by_id") @db.Uuid
  updatedAt              DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  currency  Currency @relation(fields: [currencyCode, currencyMinorUnits], references: [code, minorUnits], onDelete: Restrict)
  updatedBy User?    @relation("PlatformSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity, authentication, authorization
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  fullName          String     @map("full_name") @db.VarChar(120)
  /// Lower-cased, trimmed. Uniqueness enforced on this normalized value.
  email             String     @unique @db.VarChar(254)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status            UserStatus @default(PENDING_VERIFICATION)
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  phone             String?    @db.VarChar(20)
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  avatarUrl         String?    @map("avatar_url") @db.VarChar(2048)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  suspendedAt       DateTime?  @map("suspended_at") @db.Timestamptz(3)
  suspensionReason  String?    @map("suspension_reason") @db.VarChar(500)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions               Session[]
  challenges             EmailChallenge[]
  mfaFactors             UserMfaFactor[]
  roles                  UserRole[]               @relation("UserRoleUser")
  rolesGranted           UserRole[]               @relation("UserRoleGrantedBy")
  programAssignments     ProgramAdminAssignment[] @relation("ProgramAdminUser")
  referralCodes          ReferralCode[]
  sponsorRelationship    ReferralRelationship?    @relation("ReferralChild")
  sponsoredRelationships ReferralRelationship[]   @relation("ReferralSponsor")
  ancestorPaths          ReferralPath[]           @relation("PathDescendant")
  descendantPaths        ReferralPath[]           @relation("PathAncestor")
  enrollments            ProgramEnrollment[]      @relation("EnrollmentUser")
  sponsoredEnrollments   ProgramEnrollment[]      @relation("EnrollmentSponsor")
  paymentsRecorded       ProgramEnrollment[]      @relation("EnrollmentPaymentRecordedBy")
  qualifyingEvents       QualifyingEvent[]        @relation("EventSubject")
  rewardsReceived        Reward[]                 @relation("RewardRecipient")
  ledgerAccounts         LedgerAccount[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  flags                  MemberFlag[]             @relation("FlagSubject")
  referralCorrections    ReferralCorrection[]     @relation("CorrectionChild")
  settingsUpdates        PlatformSettings[]       @relation("PlatformSettingsUpdatedBy")
  programsCreated        Program[]                @relation("ProgramCreatedBy")
  programsUpdated        Program[]                @relation("ProgramUpdatedBy")
  programStatusChanges   ProgramStatusChange[]
  policiesCreated        RewardPolicyVersion[]    @relation("PolicyCreatedBy")
  policiesPublished      RewardPolicyVersion[]    @relation("PolicyPublishedBy")
  eventsRecorded         QualifyingEvent[]        @relation("EventRecordedBy")
  rewardsApproved        Reward[]                 @relation("RewardApprovedBy")
  rewardsRejected        Reward[]                 @relation("RewardRejectedBy")
  rewardsReversed        Reward[]                 @relation("RewardReversedBy")
  ledgerTxnsPosted       LedgerTransaction[]      @relation("LedgerPostedBy")
  offeringsCreated       Offering[]               @relation("OfferingCreatedBy")
  offeringsApproved      Offering[]               @relation("OfferingApprovedBy")
  flagsCreated           MemberFlag[]             @relation("FlagCreatedBy")
  flagsResolved          MemberFlag[]             @relation("FlagResolvedBy")
  correctionsPerformed   ReferralCorrection[]     @relation("CorrectionPerformedBy")
  apiClientsCreated      ApiClient[]
  idempotencyKeys        IdempotencyKey[]

  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_users_full_name_trgm")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_users_email_trgm")
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  /// SHA-256 of the opaque session token. The raw token only ever lives in the cookie.
  tokenHash     String     @unique @map("token_hash") @db.Char(64)
  /// Set when a second factor was completed in this session (admin access requires a recent one).
  mfaVerifiedAt DateTime?  @map("mfa_verified_at") @db.Timestamptz(3)
  mfaMethod     MfaMethod? @map("mfa_method")
  ipAddress     String?    @map("ip_address") @db.VarChar(64)
  userAgent     String?    @map("user_agent") @db.VarChar(512)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry; idle expiry is computed from lastSeenAt.
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokeReason  String?    @map("revoke_reason") @db.VarChar(64)

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges EmailChallenge[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time codes sent by email. At most one open challenge per (email, purpose) (partial unique
/// index). Registration data waits on the EMAIL_VERIFICATION challenge: the users row is created
/// only when the code is verified (prevents email squatting / attribution hijacking).
model EmailChallenge {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String?          @map("user_id") @db.Uuid
  /// LOGIN_MFA challenges elevate only the session that requested them.
  sessionId             String?          @map("session_id") @db.Uuid
  /// The address the code was sent to (normalized). For EMAIL_CHANGE this is the new address.
  email                 String           @db.VarChar(254)
  purpose               ChallengePurpose
  /// HMAC-SHA-256 of the code using a server-side pepper. Raw codes are never stored.
  codeHash              String           @map("code_hash") @db.Char(64)
  attempts              Int              @default(0)
  maxAttempts           Int              @default(5) @map("max_attempts")
  sendCount             Int              @default(1) @map("send_count")
  lastSentAt            DateTime         @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?        @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt         DateTime?        @map("invalidated_at") @db.Timestamptz(3)
  /// Pending registration payload (EMAIL_VERIFICATION for a not-yet-created account only).
  pendingFullName       String?          @map("pending_full_name") @db.VarChar(120)
  pendingPasswordHash   String?          @map("pending_password_hash") @db.VarChar(255)
  pendingReferralCodeId String?          @map("pending_referral_code_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session             Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pendingReferralCode ReferralCode? @relation(fields: [pendingReferralCodeId], references: [id], onDelete: SetNull)

  @@index([email, purpose, createdAt])
  @@index([userId, purpose])
  @@map("email_challenges")
}

/// Independent second factors (TOTP). Required for every user holding an administrative role.
model UserMfaFactor {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  kind         MfaFactorKind
  label        String        @default("Authenticator app") @db.VarChar(64)
  /// AES-256-GCM encrypted TOTP secret (key from env MFA_ENCRYPTION_KEY).
  secretEnc    Bytes         @map("secret_enc")
  /// Set when the user proved possession with a first valid code.
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  /// Last accepted TOTP time-step, to reject replays.
  lastUsedStep BigInt?       @map("last_used_step")
  lastUsedAt   DateTime?     @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique "uq_mfa_factors_one_active" (user_id, kind) WHERE revoked_at IS NULL in SQL.
  @@index([userId])
  @@map("user_mfa_factors")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// SUPER_ADMIN | PROGRAM_ADMIN | FINANCE_REVIEWER | MEMBER
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  /// e.g. "programs:write", "rewards:approve"
  key         String  @unique @db.VarChar(64)
  description String? @db.VarChar(500)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Scopes a PROGRAM_ADMIN to specific programs.
model ProgramAdminAssignment {
  userId    String   @map("user_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation("ProgramAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([userId, programId])
  @@index([programId])
  @@map("program_admin_assignments")
}

/// Server-side idempotency records for financial mutations (Idempotency-Key header).
model IdempotencyKey {
  actorUserId    String            @map("actor_user_id") @db.Uuid
  key            String            @db.VarChar(128)
  route          String            @db.VarChar(128)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status") @db.SmallInt
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@id([actorUserId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog & programs
// ─────────────────────────────────────────────────────────────────────────────

/// An approved product or service. Rewards can only be triggered by sales of ACTIVE offerings.
/// New offerings start INACTIVE; activation requires approval (`offerings:approve`).
model Offering {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(160)
  description  String?        @db.VarChar(2000)
  kind         OfferingKind
  sku          String?        @unique @db.VarChar(64)
  status       OfferingStatus @default(INACTIVE)
  approvedById String?        @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?      @map("approved_at") @db.Timestamptz(3)
  createdById  String?        @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy  User?             @relation("OfferingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?             @relation("OfferingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  programs   Program[]
  events     QualifyingEvent[]

  @@map("offerings")
}

model Program {
  id                 String        @id @default(uuid()) @db.Uuid
  /// Human-friendly unique identifier (slug), e.g. "spring-2027".
  code               String        @unique @db.VarChar(64)
  name               String        @db.VarChar(160)
  description        String?       @db.VarChar(5000)
  status             ProgramStatus @default(DRAFT)
  offeringId         String        @map("offering_id") @db.Uuid
  /// IANA time zone used to interpret and display program dates.
  timezone           String        @default("Asia/Kolkata") @db.VarChar(64)
  startsAt           DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?     @map("ends_at") @db.Timestamptz(3)
  enrollmentOpensAt  DateTime      @map("enrollment_opens_at") @db.Timestamptz(3)
  enrollmentClosesAt DateTime?     @map("enrollment_closes_at") @db.Timestamptz(3)
  /// Hard ceiling for reward depth of any policy version in this program (1..10).
  maxRewardDepth     Int           @default(5) @map("max_reward_depth") @db.SmallInt
  /// Days after endsAt during which late-recorded sales (occurring before endsAt) are accepted.
  lateEventGraceDays Int           @default(30) @map("late_event_grace_days") @db.SmallInt
  /// Snapshot of platform unit/currency at creation; frozen once the program leaves DRAFT.
  rewardUnit         RewardUnit    @map("reward_unit")
  currencyCode       String        @map("currency_code") @db.Char(3)
  currencyMinorUnits Int           @map("currency_minor_units") @db.SmallInt
  /// Structured eligibility rules (validated by the shared ProgramEligibility schema).
  eligibility        Json          @default("{}")
  termsVersion       String        @default("1.0") @map("terms_version") @db.VarChar(32)
  termsText          String?       @map("terms_text")
  /// Optimistic-concurrency token; incremented by trigger on every update.
  version            Int           @default(1)
  createdById        String?       @map("created_by_id") @db.Uuid
  updatedById        String?       @map("updated_by_id") @db.Uuid
  publishedAt        DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  offering         Offering                 @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  currency         Currency                 @relation(fields: [currencyCode, currencyMinorUnits], references: [code, minorUnits], onDelete: Restrict)
  createdBy        User?                    @relation("ProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?                    @relation("ProgramUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  options          ProgramOption[]
  policyVersions   RewardPolicyVersion[]
  enrollments      ProgramEnrollment[]
  events           QualifyingEvent[]
  rewards          Reward[]
  adminAssignments ProgramAdminAssignment[]
  statusChanges    ProgramStatusChange[]
  apiClients       ApiClient[]

  @@index([status])
  @@map("programs")
}

/// Append-only history of program status changes (written by trigger). Used to decide whether
/// a program was ACTIVE at a sale's occurredAt, and for the program timeline.
model ProgramStatusChange {
  id          String         @id @default(uuid()) @db.Uuid
  programId   String         @map("program_id") @db.Uuid
  fromStatus  ProgramStatus? @map("from_status")
  toStatus    ProgramStatus  @map("to_status")
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedById String?        @map("changed_by_id") @db.Uuid
  reason      String?        @db.VarChar(1000)

  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([programId, changedAt])
  @@map("program_status_changes")
}

/// A participation plan for a program (e.g. monthly / annual subscription to the program's
/// service). The plan price is paid by the member and is NEVER a reward trigger.
model ProgramOption {
  id               String           @id @default(uuid()) @db.Uuid
  programId        String           @map("program_id") @db.Uuid
  name             String           @db.VarChar(120)
  description      String?          @db.VarChar(1000)
  priceMinor       BigInt           @map("price_minor")
  currencyCode     String           @map("currency_code") @db.Char(3)
  billingFrequency BillingFrequency @map("billing_frequency")
  durationDays     Int              @map("duration_days")
  renewalPolicy    RenewalPolicy    @default(MANUAL) @map("renewal_policy")
  isActive         Boolean          @default(true) @map("is_active")
  sortOrder        Int              @default(0) @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollments ProgramEnrollment[]

  @@index([programId, isActive])
  @@map("program_options")
}

model ProgramEnrollment {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  programId           String            @map("program_id") @db.Uuid
  optionId            String            @map("option_id") @db.Uuid
  /// Immutable copy of the option terms at enrollment time.
  optionSnapshot      Json              @map("option_snapshot")
  termsVersion        String            @map("terms_version") @db.VarChar(32)
  status              EnrollmentStatus  @default(PENDING)
  eligibilityStatus   EligibilityStatus @default(PENDING_REVIEW) @map("eligibility_status")
  /// Sponsor at the time of enrollment (attribution snapshot from the referral tree).
  sponsorUserId       String?           @map("sponsor_user_id") @db.Uuid
  /// Coverage period [effectiveFrom, effectiveTo). Frozen once set (cancellation may shorten it).
  effectiveFrom       DateTime?         @map("effective_from") @db.Timestamptz(3)
  effectiveTo         DateTime?         @map("effective_to") @db.Timestamptz(3)
  /// Offline payment record for paid options (required to activate a paid option). These
  /// references can never be reused as qualifying-event ids (DB trigger).
  paymentReference    String?           @unique @map("payment_reference") @db.VarChar(128)
  paymentAmountMinor  BigInt?           @map("payment_amount_minor")
  paymentRecordedById String?           @map("payment_recorded_by_id") @db.Uuid
  paymentRecordedAt   DateTime?         @map("payment_recorded_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  statusReason        String?           @map("status_reason") @db.VarChar(500)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User          @relation("EnrollmentUser", fields: [userId], references: [id], onDelete: Restrict)
  program           Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  option            ProgramOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  sponsor           User?         @relation("EnrollmentSponsor", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  paymentRecordedBy User?         @relation("EnrollmentPaymentRecordedBy", fields: [paymentRecordedById], references: [id], onDelete: SetNull)

  // SQL: partial unique "uq_enrollments_one_pending", exclusion "ex_enrollments_no_overlap",
  // partial indexes for eligibility lookups and the expiry sweep.
  @@index([userId, programId])
  @@index([programId, status])
  @@map("program_enrollments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Referral tree (adjacency list + closure table)
// ─────────────────────────────────────────────────────────────────────────────

model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Reserved for program-specific codes; NULL = the member's global code.
  programId String?  @map("program_id") @db.Uuid
  code      String   @unique @db.VarChar(16)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationships        ReferralRelationship[]
  pendingRegistrations EmailChallenge[]

  // Partial unique index "uq_referral_codes_global_per_user" (program_id IS NULL AND is_active) in SQL.
  @@index([userId])
  @@map("referral_codes")
}

/// Direct sponsor link. Exactly one per child, written once in the transaction that creates the
/// user; corrections only via the audited admin workflow (guarded by DB triggers).
model ReferralRelationship {
  id                    String         @id @default(uuid()) @db.Uuid
  childUserId           String         @unique @map("child_user_id") @db.Uuid
  sponsorUserId         String         @map("sponsor_user_id") @db.Uuid
  referralCodeId        String?        @map("referral_code_id") @db.Uuid
  source                ReferralSource @default(REGISTRATION)
  registrationIp        String?        @map("registration_ip") @db.Inet
  registrationUserAgent String?        @map("registration_user_agent") @db.VarChar(512)
  attributedAt          DateTime       @default(now()) @map("attributed_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  child        User          @relation("ReferralChild", fields: [childUserId], references: [id], onDelete: Restrict)
  sponsor      User          @relation("ReferralSponsor", fields: [sponsorUserId], references: [id], onDelete: Restrict)
  referralCode ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)

  @@index([sponsorUserId, attributedAt])
  @@index([sponsorUserId, registrationIp, attributedAt])
  @@map("referral_relationships")
}

/// Closure table: one row for every (ancestor, descendant) pair including self (depth 0).
model ReferralPath {
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   User @relation("PathAncestor", fields: [ancestorId], references: [id], onDelete: Restrict)
  descendant User @relation("PathDescendant", fields: [descendantId], references: [id], onDelete: Restrict)

  @@id([ancestorId, descendantId])
  /// A descendant has exactly one ancestor at each depth (the tree is a tree, not a DAG).
  @@unique([descendantId, depth], map: "uq_referral_paths_descendant_depth")
  @@index([ancestorId, depth])
  @@map("referral_paths")
}

/// Immutable record of every administrative sponsor correction. Its id must be set as
/// `app.referral_correction_id` (SET LOCAL) for the tree triggers to allow the rewrite.
model ReferralCorrection {
  id                String   @id @default(uuid()) @db.Uuid
  childUserId       String   @map("child_user_id") @db.Uuid
  previousSponsorId String?  @map("previous_sponsor_id") @db.Uuid
  newSponsorId      String   @map("new_sponsor_id") @db.Uuid
  reason            String   @db.VarChar(1000)
  performedById     String   @map("performed_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  child       User @relation("CorrectionChild", fields: [childUserId], references: [id], onDelete: Restrict)
  performedBy User @relation("CorrectionPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([childUserId])
  @@map("referral_corrections")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reward policy (effective-dated, immutable once published)
// ─────────────────────────────────────────────────────────────────────────────

model RewardPolicyVersion {
  id                         String                     @id @default(uuid()) @db.Uuid
  programId                  String                     @map("program_id") @db.Uuid
  version                    Int
  status                     PolicyStatus               @default(DRAFT)
  name                       String                     @db.VarChar(160)
  notes                      String?                    @db.VarChar(2000)
  /// Which qualifying event types this version rewards.
  triggerEventTypes          QualifyingEventType[]      @map("trigger_event_types")
  maxDepth                   Int                        @map("max_depth") @db.SmallInt
  /// Total reward budget per event, in basis points of the event amount (<= 5000 hard cap).
  budgetBps                  Int                        @map("budget_bps")
  /// Optional absolute cap on total rewards per event (minor units of the reward unit).
  maxTotalPerEventMinor      BigInt?                    @map("max_total_per_event_minor")
  minEventAmountMinor        BigInt                     @default(0) @map("min_event_amount_minor")
  /// POINTS programs: points per one major currency unit of sale value (snapshot; frozen on publish).
  pointsPerCurrencyUnit      Int                        @default(1) @map("points_per_currency_unit")
  ineligibleAncestorBehavior IneligibleAncestorBehavior @default(FORFEIT) @map("ineligible_ancestor_behavior")
  roundingMode               RoundingMode               @default(HALF_UP) @map("rounding_mode")
  /// false = rewards auto-approve; publishing such a version requires SUPER_ADMIN.
  requiresApproval           Boolean                    @default(true) @map("requires_approval")
  /// Recipient must hold an ELIGIBLE enrollment covering the sale's occurredAt.
  requireActiveEnrollment    Boolean                    @default(true) @map("require_active_enrollment")
  effectiveFrom              DateTime                   @map("effective_from") @db.Timestamptz(3)
  /// effectiveTo = effectiveFrom on a RETIRED version means it was withdrawn before taking effect.
  effectiveTo                DateTime?                  @map("effective_to") @db.Timestamptz(3)
  createdById                String?                    @map("created_by_id") @db.Uuid
  publishedById              String?                    @map("published_by_id") @db.Uuid
  publishedAt                DateTime?                  @map("published_at") @db.Timestamptz(3)
  retiredAt                  DateTime?                  @map("retired_at") @db.Timestamptz(3)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  program      Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy  User?               @relation("PolicyPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  rules        RewardRule[]
  calculations RewardCalculation[]
  rewards      Reward[]
  events       QualifyingEvent[]

  // Exclusion constraint "ex_policy_versions_no_overlap" (non-draft ranges per program) in SQL.
  @@unique([programId, version])
  @@index([programId, status, effectiveFrom])
  @@map("reward_policy_versions")
}

model RewardRule {
  id               String         @id @default(uuid()) @db.Uuid
  policyVersionId  String         @map("policy_version_id") @db.Uuid
  /// 1 = direct sponsor of the event subject, 2 = sponsor's sponsor, ...
  level            Int            @db.SmallInt
  calcType         RewardCalcType @map("calc_type")
  /// FIXED: amount in minor units of the reward unit.
  fixedAmountMinor BigInt?        @map("fixed_amount_minor")
  /// PERCENTAGE: basis points of the event amount (100 bps = 1%).
  percentageBps    Int?           @map("percentage_bps")
  /// Optional per-level cap in minor units of the reward unit.
  capMinor         BigInt?        @map("cap_minor")

  policyVersion RewardPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)

  @@unique([policyVersionId, level])
  @@map("reward_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations, qualifying events → calculations → rewards
// ─────────────────────────────────────────────────────────────────────────────

/// A machine credential allowed to submit qualifying events for exactly one program.
model ApiClient {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  programId   String    @map("program_id") @db.Uuid
  /// First characters of the key, for display only.
  keyPrefix   String    @map("key_prefix") @db.VarChar(16)
  /// SHA-256 of the full API key. The key itself is shown once at creation.
  keyHash     String    @unique @map("key_hash") @db.Char(64)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  program   Program           @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  events    QualifyingEvent[]

  @@index([programId])
  @@map("api_clients")
}

/// A verified sale of an approved Offering to an end customer, credited to a subject member.
/// May generate rewards for the subject's eligible ancestors.
model QualifyingEvent {
  id                String                @id @default(uuid()) @db.Uuid
  programId         String                @map("program_id") @db.Uuid
  offeringId        String                @map("offering_id") @db.Uuid
  type              QualifyingEventType
  source            QualifyingEventSource
  /// The sale's id in the upstream system. Idempotency: (offeringId, externalId, revision) unique.
  externalId        String                @map("external_id") @db.VarChar(128)
  /// 0 for the first record of a sale; a re-record after REJECTED/REVERSED supersedes it.
  revision          Int                   @default(0) @db.SmallInt
  supersedesEventId String?               @unique @map("supersedes_event_id") @db.Uuid
  /// SHA-256 of the canonical request; a replay with a different payload is a conflict.
  requestHash       String                @map("request_hash") @db.Char(64)
  /// End customer of the sale (upstream customer id / invoice party), required for audit.
  customerReference String                @map("customer_reference") @db.VarChar(128)
  /// The member credited with the sale. Rewards go to this member's ancestors.
  subjectUserId     String                @map("subject_user_id") @db.Uuid
  amountMinor       BigInt                @map("amount_minor")
  currencyCode      String                @map("currency_code") @db.Char(3)
  occurredAt        DateTime              @map("occurred_at") @db.Timestamptz(3)
  status            QualifyingEventStatus @default(RECEIVED)
  policyVersionId   String?               @map("policy_version_id") @db.Uuid
  processedAt       DateTime?             @map("processed_at") @db.Timestamptz(3)
  rejectionReason   String?               @map("rejection_reason") @db.VarChar(500)
  reversedAt        DateTime?             @map("reversed_at") @db.Timestamptz(3)
  reversalReason    String?               @map("reversal_reason") @db.VarChar(500)
  description       String?               @db.VarChar(500)
  /// ADMIN_MANUAL events: the admin who recorded it. API/WEBHOOK events: the api client.
  recordedById      String?               @map("recorded_by_id") @db.Uuid
  apiClientId       String?               @map("api_client_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  program       Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  offering      Offering             @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  subject       User                 @relation("EventSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  policyVersion RewardPolicyVersion? @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  recordedBy    User?                @relation("EventRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  apiClient     ApiClient?           @relation(fields: [apiClientId], references: [id], onDelete: Restrict)
  supersedes    QualifyingEvent?     @relation("EventRevision", fields: [supersedesEventId], references: [id], onDelete: Restrict)
  supersededBy  QualifyingEvent?     @relation("EventRevision")
  calculation   RewardCalculation?
  rewards       Reward[]

  @@unique([offeringId, externalId, revision], map: "uq_events_sale_revision")
  @@index([programId, status, occurredAt])
  @@index([subjectUserId])
  @@index([createdAt])
  @@map("qualifying_events")
}

/// Immutable record of exactly one calculation per event, with a full trace and the
/// snapshot of every input needed to re-derive it.
model RewardCalculation {
  id                    String             @id @default(uuid()) @db.Uuid
  eventId               String             @unique @map("event_id") @db.Uuid
  policyVersionId       String             @map("policy_version_id") @db.Uuid
  outcome               CalculationOutcome
  rewardUnit            RewardUnit         @map("reward_unit")
  currencyCode          String             @map("currency_code") @db.Char(3)
  currencyMinorUnits    Int                @map("currency_minor_units") @db.SmallInt
  pointsPerCurrencyUnit Int                @map("points_per_currency_unit")
  /// Sale amount converted to reward-unit minor units.
  baseMinor             BigInt             @map("base_minor")
  budgetBps             Int                @map("budget_bps")
  budgetMinor           BigInt             @map("budget_minor")
  totalAllocatedMinor   BigInt             @map("total_allocated_minor")
  /// Step-by-step trace: inputs, ancestors considered, eligibility decisions, rounding, caps.
  /// Admin-only (never exposed to members).
  trace                 Json
  engineVersion         String             @map("engine_version") @db.VarChar(32)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  event         QualifyingEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  policyVersion RewardPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  rewards       Reward[]

  @@map("reward_calculations")
}

model Reward {
  id              String       @id @default(uuid()) @db.Uuid
  calculationId   String       @map("calculation_id") @db.Uuid
  eventId         String       @map("event_id") @db.Uuid
  programId       String       @map("program_id") @db.Uuid
  policyVersionId String       @map("policy_version_id") @db.Uuid
  recipientUserId String       @map("recipient_user_id") @db.Uuid
  level           Int          @db.SmallInt
  amountMinor     BigInt       @map("amount_minor")
  rewardUnit      RewardUnit   @map("reward_unit")
  currencyCode    String       @map("currency_code") @db.Char(3)
  status          RewardStatus @default(PENDING_APPROVAL)
  approvedById    String?      @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?    @map("approved_at") @db.Timestamptz(3)
  rejectedById    String?      @map("rejected_by_id") @db.Uuid
  rejectedAt      DateTime?    @map("rejected_at") @db.Timestamptz(3)
  rejectionReason String?      @map("rejection_reason") @db.VarChar(500)
  postedAt        DateTime?    @map("posted_at") @db.Timestamptz(3)
  reversedById    String?      @map("reversed_by_id") @db.Uuid
  reversedAt      DateTime?    @map("reversed_at") @db.Timestamptz(3)
  reversalReason  String?      @map("reversal_reason") @db.VarChar(500)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  calculation        RewardCalculation   @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  event              QualifyingEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  program            Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  policyVersion      RewardPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  recipient          User                @relation("RewardRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  approvedBy         User?               @relation("RewardApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy         User?               @relation("RewardRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  reversedBy         User?               @relation("RewardReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  ledgerTransactions LedgerTransaction[]

  @@unique([eventId, level])
  @@unique([eventId, recipientUserId], map: "uq_rewards_event_recipient")
  @@index([recipientUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([programId, status, createdAt])
  @@index([createdAt])
  @@map("rewards")
}

// ─────────────────────────────────────────────────────────────────────────────
// Double-entry ledger (append-only)
// ─────────────────────────────────────────────────────────────────────────────

model LedgerAccount {
  id           String            @id @default(uuid()) @db.Uuid
  type         LedgerAccountType
  /// Owner for member accounts; NULL for platform accounts.
  userId       String?           @map("user_id") @db.Uuid
  rewardUnit   RewardUnit        @map("reward_unit")
  currencyCode String            @map("currency_code") @db.Char(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  // Partial unique indexes "uq_ledger_accounts_member" / "uq_ledger_accounts_platform" in SQL.
  // Create accounts with INSERT ... ON CONFLICT DO NOTHING (see LedgerService).
  @@index([userId])
  @@map("ledger_accounts")
}

/// One posting and at most one reversal per reward. The header records the entry count and
/// debit total so entries appended later fail the commit-time balance check.
model LedgerTransaction {
  id                    String                @id @default(uuid()) @db.Uuid
  type                  LedgerTransactionType
  /// Exactly "reward-posting:<rewardId>" or "reward-reversal:<rewardId>" (DB trigger).
  idempotencyKey        String                @unique @map("idempotency_key") @db.VarChar(160)
  rewardId              String                @map("reward_id") @db.Uuid
  /// For REWARD_REVERSAL: the REWARD_POSTING being compensated.
  reversesTransactionId String?               @unique @map("reverses_transaction_id") @db.Uuid
  entryCount            Int                   @map("entry_count") @db.SmallInt
  debitTotalMinor       BigInt                @map("debit_total_minor")
  description           String?               @db.VarChar(500)
  postedById            String?               @map("posted_by_id") @db.Uuid
  postedAt              DateTime              @default(now()) @map("posted_at") @db.Timestamptz(3)

  reward     Reward             @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  postedBy   User?              @relation("LedgerPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reverses   LedgerTransaction? @relation("LedgerReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("LedgerReversal")
  entries    LedgerEntry[]

  @@unique([rewardId, type], map: "uq_ledger_txn_reward_type")
  @@index([postedAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  amountMinor   BigInt         @map("amount_minor")
  rewardUnit    RewardUnit     @map("reward_unit")
  currencyCode  String         @map("currency_code") @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit, notifications, outbox, risk
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only (UPDATE/DELETE blocked by trigger). before/after hold an allow-list of changed
/// fields only; a CHECK rejects secret-looking keys. Emails/phones are stored masked.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorRoles   String[] @map("actor_roles")
  action       String   @db.VarChar(96)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  /// Set for program-scoped entries so PROGRAM_ADMINs can be shown only their programs' history.
  programId    String?  @map("program_id") @db.Uuid
  before       Json?
  after        Json?
  reason       String?  @db.VarChar(1000)
  requestId    String?  @map("request_id") @db.VarChar(64)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([programId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(2000)
  data      Json?
  /// De-duplicates at-least-once delivery (e.g. the outbox message id).
  sourceKey String?   @unique @map("source_key") @db.VarChar(160)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Transactional outbox: written in the same DB transaction as the business change,
/// delivered asynchronously by the worker (email, notifications, webhooks).
/// OTP emails carry only an AES-GCM ciphertext of the code, scrubbed once delivered.
model OutboxMessage {
  id          String       @id @default(uuid()) @db.Uuid
  topic       String       @db.VarChar(96)
  payload     Json
  /// Optional de-duplication key (unique when present).
  dedupeKey   String?      @unique @map("dedupe_key") @db.VarChar(160)
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  maxAttempts Int          @default(8) @map("max_attempts")
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error") @db.VarChar(2000)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_messages")
}

/// Suspicious-activity flags raised by fraud heuristics or administrators.
model MemberFlag {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  /// e.g. "SHARED_IP_REGISTRATIONS", "MANUAL_REPORT"
  kind         String     @db.VarChar(64)
  details      String     @db.VarChar(2000)
  status       FlagStatus @default(OPEN)
  /// Heuristic flags upsert on this key while OPEN (partial unique index in SQL).
  dedupeKey    String?    @map("dedupe_key") @db.VarChar(160)
  createdById  String?    @map("created_by_id") @db.Uuid
  resolvedById String?    @map("resolved_by_id") @db.Uuid
  resolution   String?    @db.VarChar(1000)
  resolvedAt   DateTime?  @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation("FlagSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User? @relation("FlagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("FlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("member_flags")
}
