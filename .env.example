# ── Copy to .env (root) and apps/api/.env for local development. Placeholders only. ──

# Application
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:8080
API_PORT=4000
# Comma-separated list of allowed browser origins (nginx origin in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Honour X-Forwarded-For / X-Forwarded-Proto from a reverse proxy (nginx). false | true (=1 hop) | hop count
TRUST_PROXY=false

# PostgreSQL
POSTGRES_USER=referral
POSTGRES_PASSWORD=change_me
POSTGRES_DB=referral
POSTGRES_PORT=5432
DATABASE_URL=postgresql://referral:change_me@localhost:5432/referral?schema=public
TEST_DATABASE_URL=postgresql://referral:change_me@localhost:5432/referral_test?schema=public
# Max connections in the API's pg pool
DATABASE_POOL_MAX=10

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
# Run the outbox relay + scheduled jobs inside the API process (dev convenience; production runs dist/worker.js)
RUN_WORKER_IN_API=false

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=replace_with_64_hex_chars
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
ADMIN_SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Email (SMTP). In development, Mailpit listens on 1025 (UI on 8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Referral Platform <no-reply@example.com>"

# Seed — initial Super Admin (created only by `pnpm db:seed`)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change_me_Str0ng!
SEED_DEMO_DATA=true

# Logging
LOG_LEVEL=info

# Rate limiting (per client IP). THROTTLE_STORAGE=memory (per process) | redis (shared across replicas)
THROTTLE_STORAGE=memory
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_DEFAULT_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_OTP_LIMIT=5
THROTTLE_OTP_TTL_SECONDS=60

# ── Production compose (docker-compose.prod.yml) ──
# Compose builds DATABASE_URL / REDIS_URL from POSTGRES_* / REDIS_PASSWORD (use URL-safe values,
# e.g. `openssl rand -hex 24`) and pins NODE_ENV=production, TRUST_PROXY=true (behind nginx),
# THROTTLE_STORAGE=redis and RUN_WORKER_IN_API=false. Before going live ALSO set:
#   APP_PUBLIC_URL=https://<your host>   CORS_ORIGINS=<same origin>   COOKIE_SECURE=true
#   OTP_PEPPER=<64 hex>   SMTP_*/MAIL_FROM for a real provider   SEED_DEMO_DATA=false
# For a local prod-like run with `--profile dev-mail`: SMTP_HOST=mailpit SMTP_PORT=1025.
REDIS_PASSWORD=change_me_redis
# Host port of nginx (the single public origin) and of Mailpit's UI with --profile dev-mail (127.0.0.1 only)
NGINX_HTTP_PORT=8080
MAILPIT_UI_PORT=8025
# Image names: ${IMAGE_REGISTRY}/api:${IMAGE_TAG}, .../web, .../api-tools
IMAGE_REGISTRY=referral-platform
IMAGE_TAG=latest

# ── End-to-end tests (Playwright) ──
# E2E_BASE_URL=http://localhost:8080
# MAILPIT_URL=http://localhost:8025
