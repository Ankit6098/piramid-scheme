# ── Copy to .env (root) and apps/api/.env for local development. Placeholders only. ──

# Application
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:8080
API_PORT=4000
# Comma-separated list of allowed browser origins (nginx origin in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL
POSTGRES_USER=referral
POSTGRES_PASSWORD=change_me
POSTGRES_DB=referral
POSTGRES_PORT=5432
DATABASE_URL=postgresql://referral:change_me@localhost:5432/referral?schema=public
TEST_DATABASE_URL=postgresql://referral:change_me@localhost:5432/referral_test?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=replace_with_64_hex_chars
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
ADMIN_SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Email (SMTP). In development, Mailpit listens on 1025 (UI on 8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Referral Platform <no-reply@example.com>"

# Seed — initial Super Admin (created only by `pnpm db:seed`)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change_me_Str0ng!
SEED_DEMO_DATA=true

# Logging
LOG_LEVEL=info
